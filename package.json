{
  "name": "@miri-unicorn/paper",
  "version": "0.13.0",
  "description": "The Swiss Army Knife of Vector Graphics Scripting",
  "license": "MIT",
  "homepage": "http://paperjs.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/miridih-jwpark/paper.js"
  },
  "publishConfig": {
    "registry": "https://repo.miridih.com/nexus/repository/npm-miri-private/"
  },
  "bugs": "https://github.com/paperjs/paper.js/issues",
  "contributors": [
    "Jürg Lehni <juerg@scratchdisk.com> (http://scratchdisk.com)",
    "Jonathan Puckey <jonathan@puckey.studio> (http://studiomoniker.com)"
  ],
  "main": "dist/paper-full.js",
  "types": "dist/paper.d.ts",
  "scripts": {
    "build": "node scripts/build.js",
    "minify": "node scripts/minify.js",
    "dist": "node scripts/dist.js",
    "docs": "node scripts/docs.js",
    "load": "node scripts/load.js",
    "test": "node scripts/test.js",
    "test:browser": "node scripts/test.js testBrowser",
    "test:node": "node scripts/test.js testNode",
    "watch": "node scripts/watch.js",
    "publish": "node scripts/publish.js"
  },
  "files": [
    "AUTHORS.md",
    "CHANGELOG.md",
    "dist/",
    "examples/",
    "LICENSE.txt",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm jshint --ensure-branch develop",
      "pre-push": "pnpm test --ensure-branch develop"
    }
  },
  "browser": {
    "./dist/node/extend.js": false,
    "./dist/node/self.js": false,
    "canvas": false,
    "jsdom": false,
    "jsdom/lib/jsdom/living/generated/utils": false,
    "source-map-support": false
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/register": "^7.25.9",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "acorn": "^8.11.3",
    "ansi-colors": "^4.1.3",
    "chokidar": "^4.0.3",
    "del": "^7.1.0",
    "fancy-log": "^2.0.0",
    "husky": "^8.0.3",
    "jsdom": "^23.2.0",
    "jshint": "^2.13.6",
    "jshint-summary": "^0.4.0",
    "merge-stream": "^2.0.0",
    "minimist": "^1.2.8",
    "mustache": "^4.2.0",
    "node-libs-browser": "^2.2.1",
    "playwright": "^1.42.1",
    "prepro": "^2.4.0",
    "qunitjs": "^2.4.1",
    "resemblejs": "^5.0.0",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "source-map-support": "^0.5.21",
    "stats.js": "^0.17.0",
    "straps": "^3.0.1",
    "typescript": "^5.3.3",
    "vite": "^6.2.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "resolutions": {
    "graceful-fs": "^4.2.11",
    "vinyl-fs": "^3.0.3",
    "natives": "^1.1.6",
    "glob": "^10.3.10"
  },
  "keywords": [
    "vector",
    "graphic",
    "graphics",
    "2d",
    "geometry",
    "bezier",
    "curve",
    "curves",
    "path",
    "paths",
    "canvas",
    "svg",
    "paper",
    "paper.js",
    "paperjs"
  ]
}
